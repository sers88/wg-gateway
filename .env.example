# wg-gateway configuration
# Copy this file to .env and modify as needed.

# --- WireGuard (wg-easy v15) ---
# Public IP or hostname of this server (REQUIRED for client config generation)
WG_HOST=your-server-public-ip
# WireGuard server UDP port
WG_PORT=51820
# DNS servers advertised to WireGuard clients
# With Mihomo dns-hijack active, any DNS will be intercepted
WG_DEFAULT_DNS=1.1.1.1
# Routes advertised to clients (0.0.0.0/0 = all traffic through the gateway)
WG_ALLOWED_IPS=0.0.0.0/0,::/0
# Keepalive interval in seconds (configure via the wg-easy Web UI after first start)
WG_PERSISTENT_KEEPALIVE=25
# wg-easy Web UI port
WG_EASY_PORT=51821
# Admin credentials for wg-easy v15 unattended setup (plaintext, NOT bcrypt).
# These are used once on first container start to create the admin account.
# After setup you may remove them from the env file.
WG_EASY_INIT_USERNAME=admin
WG_EASY_INIT_PASSWORD=your-secure-password-here
# Allow HTTP access (required when not using an HTTPS reverse proxy)
INSECURE=true

# --- Proxy Engine (Mihomo) ---
# External controller / Web UI port
MIHOMO_PORT=51888
# Optional secret for the external controller API
MIHOMO_SECRET=
# NOTE: v15 no longer supports WG_POST_UP / WG_POST_DOWN env variables.
# Gateway iptables FORWARD rules are managed automatically by setup-routing.sh.
WG_POST_UP=
WG_POST_DOWN=

# --- General ---
TZ=UTC
